MERGE (a:Entity {id:'巴山木竹'}) SET a.name='巴山木竹';
MERGE (b:Place {id:'岷山山系'}) SET b.name='岷山山系';
MATCH (a {id:'巴山木竹'}), (b {id:'岷山山系'}) MERGE (a)-[r:RELATED_TO]->(b) SET r.source_file='D:\panda\docs\熊猫知识\[202108031645]大熊猫奇妙课堂野生大熊猫的食性.md', r.evidence='不同山系的野生大熊猫，喜欢的竹子种类也有差异。岷山山系的喜欢巴山木竹、刺竹等；邛崃山山系的主要采食冷箭竹、华西箭竹等；大小凉山山系的主要食谱只有5种，如玉山竹、丰实箭竹等；秦岭山系的则喜欢吃华桔竹、巴山木竹等。', r.category='熊猫知识', r.last_updated='2026-07-24T13:31:08.595031';
