MATCH (a {id:'大熊猫'}), (b {id:'栖息地遭到严重破坏'}) MERGE (a)-[r:RELATED_TO]->(b) SET r.source_file='D:\panda\docs\熊猫知识\[202109111000]大熊猫奇妙课堂大熊猫的保护.md', r.evidence='大熊猫的迁地保护是就地保护的重要补充。因为大熊猫的栖息地遭到严重破坏，其种群生存受到威胁，在野外很难维持种群可持续发展的情况下，把需要保护的大熊猫转移到另外一个地方或环境中，这种措施就叫做大熊猫的移地保护。', r.category='熊猫知识', r.last_updated='2026-07-24T13:31:08.603059';
