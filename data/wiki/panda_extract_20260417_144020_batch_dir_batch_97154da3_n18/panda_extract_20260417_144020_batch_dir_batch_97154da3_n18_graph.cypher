MERGE (a:PandaKind {id:'大熊猫'}) SET a.name='大熊猫';
MERGE (b:Behavior {id:'育幼期间母熊猫用舌头舔幼仔会阴部刺激排便'}) SET b.name='育幼期间母熊猫用舌头舔幼仔会阴部刺激排便';
