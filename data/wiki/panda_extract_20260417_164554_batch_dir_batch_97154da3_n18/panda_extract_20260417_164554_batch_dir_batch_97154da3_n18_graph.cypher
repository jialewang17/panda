MERGE (a:Entity {id:'大熊猫（亚成年）'}) SET a.name='大熊猫（亚成年）';
MERGE (b:Behavior {id:'玩耍'}) SET b.name='玩耍';
MATCH (a {id:'大熊猫（亚成年）'}), (b {id:'玩耍'}) MERGE (a)-[r:RELATED_TO]->(b) SET r.source_file='D:\anyclaw\docs\熊猫知识\【熊猫知识】大熊猫生长发育 - 成都大熊猫繁育研究基地.md', r.evidence='亚成年：一岁半到性成熟前为亚成年阶段……这一阶段大熊猫的食物从营养丰富的奶为主逐渐过渡到以高纤维、低营养的竹类为主。生理和心理上也逐渐成熟……大熊猫在1~3岁期间是最为活跃的时期，每天除了采食外，大部分时间都在玩耍、探索和爬树。', r.last_updated='2026-04-17T16:45:54.928620';
